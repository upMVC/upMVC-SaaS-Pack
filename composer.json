{
    "name": "bitshost/upmvc-saas-pack",
    "description": "Installable SaaS module pack for upMVC: tenancy (JWT, plans, platform admin) plus Harvest ops kernel (mail, notify, audit, TOTP, i18n).",
    "type": "library",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.1",
        "bitshost/upmvc": "^2.4",
        "phpmailer/phpmailer": "^6.9"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "authors": [
        {
            "name": "Adrian D",
            "email": "contact@delvirai.net",
            "homepage": "https://upmvc.com",
            "role": "Developer"
        }
    ],
    "license": [
        "MIT"
    ],
    "autoload": {
        "psr-4": {
            "App\\Modules\\": "src/Modules/",
            "BitsHost\\UpmvcSaas\\": "src/Saas/"
        }
    },
    "keywords": [
        "upmvc",
        "saas",
        "multi-tenant",
        "module-pack",
        "jwt",
        "tenant-management",
        "platform-admin",
        "feature-flags",
        "harvest",
        "mail-gateway",
        "totp",
        "audit-log"
    ],
    "homepage": "https://upmvc.com",
    "autoload-dev": {
        "psr-4": {
            "BitsHost\\UpmvcSaas\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/saas-next.php"
    ]
}
